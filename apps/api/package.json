{
  "name": "@deeplearner/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node --env-file-if-exists=.env --import tsx tests/database.integration.ts"
  },
  "dependencies": {
    "@deeplearner/shared-types": "0.1.0",
    "argon2": "0.45.1",
    "cookie": "2.0.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.0",
    "google-auth-library": "11.1.0",
    "helmet": "^8.1.0",
    "jose": "6.2.12",
    "mongoose": "9.10.2",
    "pino": "^10.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0"
  }
}
