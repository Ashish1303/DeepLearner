APP_ENV=LOCAL
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info

# Required: configure a non-production target privately for LOCAL.
MONGODB_URI=
# Default strict TLS. Set false ONLY for APP_ENV=LOCAL and a single literal
# 127.0.0.1 host (mongodb://127.0.0.1:27017/). Direct mode is enforced.
# Atlas, other hosts and hosted environments always require verified TLS.
MONGODB_TLS=true
# Authoritative database name, overriding any database component in the URI.
MONGODB_DB_NAME=deeplearner-local

# F007: disabled sends nothing and is allowed only in LOCAL.
EMAIL_PROVIDER=disabled
WEB_ORIGIN=http://localhost:3000
# Required privately when EMAIL_PROVIDER=resend; never commit actual keys.
# EMAIL_FROM=verify@example.com
# RESEND_API_KEY=
AUTH_REGISTER_LIMIT=5
AUTH_REGISTER_WINDOW_MS=3600000
AUTH_VERIFY_LIMIT=10
AUTH_VERIFY_WINDOW_MS=900000
AUTH_RESEND_LIMIT=3
AUTH_RESEND_WINDOW_MS=3600000

# Future integrations only. Not loaded or required by the scaffold.
GOOGLE_CLIENT_ID=
# Reserved: ID-token verification alone does not require a client secret.
GOOGLE_CLIENT_SECRET=
AWS_REGION=
AWS_S3_BUCKET=
# Prefer workload identity/roles in hosted environments when available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AI_API_KEY=
# Refresh tokens will be opaque random secrets, not signed JWTs.

# F008 required: generate an independent random secret (>=32 bytes), base64 encoded.
# Never reuse another service secret or commit its value.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_ISSUER=deeplearner-api
ACCESS_TOKEN_AUDIENCE=deeplearner
AUTH_COOKIE_SECURE=true
# false requires LOCAL plus matching loopback API/Origin and a loopback peer.
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_IP_WINDOW_MS=900000
AUTH_REFRESH_LIMIT=60
AUTH_REFRESH_WINDOW_MS=60000

# F010 process-local recovery limits
AUTH_FORGOT_LIMIT=3
AUTH_FORGOT_WINDOW_MS=3600000
AUTH_RESET_LIMIT=10
AUTH_RESET_WINDOW_MS=900000
AUTH_CHANGE_LIMIT=5
AUTH_CHANGE_WINDOW_MS=900000
AUTH_CHANGE_IP_LIMIT=20
AUTH_CHANGE_IP_WINDOW_MS=900000
